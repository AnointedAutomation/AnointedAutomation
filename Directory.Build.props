<Project>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <!-- Shared NuGet metadata for every shipped package (test and demo projects are excluded). -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests')) And '$(MSBuildProjectName)' != 'AnointedAutomation.Objects.Demo'">
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Ship the existing /// comments as IntelliSense docs inside each package. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Undocumented members are not an error; malformed or unresolved doc comments stay visible as warnings without failing TreatWarningsAsErrors. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1592;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>

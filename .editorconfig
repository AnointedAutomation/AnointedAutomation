root = true

[*.cs]
# Member casing is intentional and is NOT enforced. Public members are sometimes
# lowercase/camelCase on purpose so they match the JSON and BSON wire contracts.
# Renaming them would change serialized field names and break clients, so the
# naming-style analyzer is turned off here even if code-style enforcement is
# enabled later (EnforceCodeStyleInBuild).
dotnet_diagnostic.IDE1006.severity = none

# File header standard (owner directive 2026-09-30). Every source file starts with this line.
# Severity is suggestion so TreatWarningsAsErrors builds are not broken by older dated headers.
file_header_template = Copyright © Anointed Automation, LLC., 2026. All Rights Reserved. Stewarded by Alexander Fields https://www.alexanderfields.me Jesus is King ✝️
dotnet_diagnostic.IDE0073.severity = suggestion

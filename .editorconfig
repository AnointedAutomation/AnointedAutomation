root = true

[*.cs]
# Member casing is intentional and is NOT enforced. Public members are sometimes
# lowercase/camelCase on purpose so they match the JSON and BSON wire contracts.
# Renaming them would change serialized field names and break clients, so the
# naming-style analyzer is turned off here even if code-style enforcement is
# enabled later (EnforceCodeStyleInBuild).
dotnet_diagnostic.IDE1006.severity = none

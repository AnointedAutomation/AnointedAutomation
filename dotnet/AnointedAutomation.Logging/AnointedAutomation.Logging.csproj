<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageProjectUrl>https://anointed.company</PackageProjectUrl>
    <Title>AnointedAutomation.Logging</Title>
    <Company>Anointed Automation Corporation - Alexander Fields</Company>
    <Copyright>Copyright © 2023 Anointed Automation Corporation All rights reserved.</Copyright>
    <Description>A lightweight log message model with severity levels, automatic caller detection and a static LogAdded event for routing logs.</Description>
    <RepositoryUrl>https://github.com/AnointedAutomation/AnointedAutomation</RepositoryUrl>
    <Version>1.0.6</Version>
    <PackageTags>logging;log;diagnostics;events;anointedautomation</PackageTags>
    <PackageReleaseNotes>https://github.com/AnointedAutomation/AnointedAutomation/commits/master/dotnet/AnointedAutomation.Logging</PackageReleaseNotes>
	  <Authors>Anointed Automation Corporation, Alexander Fields</Authors>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>

  </PropertyGroup>

  <ItemGroup>
    <None Remove="nuget.config" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="nuget.config" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageProjectUrl>https://www.anointedautomation.net/open-source</PackageProjectUrl>
		<Title>AnointedAutomation.Concepts.Anthropic</Title>
		<Company>Anointed Automation Corporation - Alexander Fields</Company>
		<Copyright>Copyright © 2026 Anointed Automation Corporation. Open source, provided "as is" without warranty (see LICENSE).</Copyright>
		<Description>Optional adapter for AnointedAutomation.Concepts: implements the ILanguageModel port with Claude through the official Anthropic .NET SDK, with structured JSON replies, typed errors and bounded retries.</Description>
		<RepositoryUrl>https://github.com/AnointedAutomation/AnointedAutomation</RepositoryUrl>
		<Version>1.0.0</Version>
		<PackageTags>concepts;reasoning;anthropic;claude;llm;theology;christian</PackageTags>
		<PackageReleaseNotes>https://github.com/AnointedAutomation/AnointedAutomation/commits/master/dotnet/AnointedAutomation.Concepts.Anthropic</PackageReleaseNotes>
		<Authors>Anointed Automation Corporation, Alexander Fields</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="AnointedAutomation.Concepts.Anthropic.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AnointedAutomation.Concepts\AnointedAutomation.Concepts.csproj" />
		<PackageReference Include="Anthropic" Version="13.8.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>AnointedAutomation.Templates</PackageId>
    <Title>AnointedAutomation.Templates</Title>
    <Version>1.0.1</Version>
    <Authors>Anointed Automation Corporation, Alexander Fields</Authors>
    <Company>Anointed Automation Corporation - Alexander Fields</Company>
    <Copyright>Copyright © 2026 Anointed Automation Corporation All rights reserved.</Copyright>
    <Description>dotnet new templates for Sign in with Anointed Automation: anointed-razor (Razor Pages) and anointed-blazor (Blazor Web App, interactive server), wired to AnointedAutomation.SSO and AnointedAutomation.SSO.UI with the client id and secret in user-secrets.</Description>
    <PackageProjectUrl>https://anointed.company</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AnointedAutomation/AnointedAutomation</RepositoryUrl>
    <PackageTags>dotnet-new;templates;aspnetcore;blazor;razor-pages;openid-connect;sso;anointedautomation</PackageTags>
    <PackageReleaseNotes>https://github.com/AnointedAutomation/AnointedAutomation/commits/master/dotnet/templates/AnointedAutomation.Templates</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>

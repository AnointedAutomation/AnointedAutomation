  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnointedAutomation/AnointedAutomation.git",
    "directory": "js/anointed-sso"
  },
  "bugs": {
    "url": "https://github.com/AnointedAutomation/AnointedAutomation/issues"
  }

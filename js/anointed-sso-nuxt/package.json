{
  "name": "@anointedautomation/sso-nuxt",
  "version": "0.1.0",
  "description": "Sign in with Anointed Automation for Nuxt 3 and 4: start, callback, logout and back-channel logout server routes built on @anointedautomation/sso. Server only.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "pretest": "node scripts/pretest.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anointedautomation/sso": "^0.2.3"
  },
  "peerDependencies": {
    "h3": ">=1.8"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    }
  },
  "devDependencies": {
    "h3": "^1.15.11"
  },
  "keywords": [
    "anointed-automation",
    "oidc",
    "sso",
    "sign-in",
    "nuxt",
    "nitro",
    "h3",
    "vue"
  ],
  "author": "Anointed Automation, LLC.",
  "license": "MIT",
  "homepage": "https://github.com/AnointedAutomation/AnointedAutomation/tree/master/js/anointed-sso-nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnointedAutomation/AnointedAutomation.git",
    "directory": "js/anointed-sso-nuxt"
  },
  "bugs": {
    "url": "https://github.com/AnointedAutomation/AnointedAutomation/issues"
  }

{
  "name": "@anointedautomation/sso-react",
  "version": "0.1.0",
  "description": "Sign in with Anointed Automation for React: an accessible brand-styled sign-in button and a useAnointedSignIn hook that send the browser to your server's start route. No secrets client side.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "pretest": "node scripts/ensure-deps.mjs",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "keywords": [
    "anointed-automation",
    "oidc",
    "sso",
    "sign-in",
    "react",
    "nextjs",
    "remix",
    "vite"
  ],
  "author": "Anointed Automation, LLC.",
  "license": "MIT",
  "homepage": "https://github.com/AnointedAutomation/AnointedAutomation/tree/master/js/anointed-sso-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnointedAutomation/AnointedAutomation.git",
    "directory": "js/anointed-sso-react"
  },
  "bugs": {
    "url": "https://github.com/AnointedAutomation/AnointedAutomation/issues"
  }
}
